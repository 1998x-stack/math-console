{
  "id": "math-teacher-pipeline",
  "version": "0.1.0",
  "schema_version": "0.1.0",
  "stage": "orchestrate",
  "title": "教师工作台总编排",
  "description": "Orchestrate an image-to-verified-math-lesson workflow; use for end-to-end image, explanation, storyboard, Manim, MP4 and PPTX requests.",
  "owner_role": "conductor",
  "inputs": [
    "source image (PNG/JPG/WebP/BMP)"
  ],
  "outputs": [
    "run.json",
    "problem.json",
    "solution.md",
    "solution.json",
    "audit.json",
    "storyboard.json",
    "storyboard.md",
    "lesson_scene.py",
    "lesson.mp4",
    "practice.json",
    "practice.pptx",
    "release.json"
  ],
  "prerequisites": [
    "有用户原始图片、输出工作区、学段和语言（默认高中/zh-CN）",
    "确认不包含未经授权公开的学生个人信息"
  ],
  "gates": [
    "不可跳过任一门槛。脚本不能替代具备视觉的 LLM、独立证明或严格模式下的真人签核。"
  ],
  "references": [
    "references/orchestration-playbook.md"
  ],
  "scripts": [
    "scripts/run_status.py"
  ],
  "assets": [
    "assets/lesson-config.example.json"
  ],
  "status": "starter-implementation",
  "requires_external_model": true,
  "requires_human_signoff_for_high_risk": false,
  "compatibility": [
    "Codex",
    "OpenCode",
    "Pi",
    "Claude Code"
  ],
  "signoff_policy": {
    "default": "auto_waiver",
    "strict": "strict",
    "semantics": "auto_waiver 是机器策略放行，不代表真人签名；独立数学审校不可跳过。"
  }
}
