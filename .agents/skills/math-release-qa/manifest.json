{
  "id": "math-release-qa",
  "version": "0.1.0",
  "schema_version": "0.1.0",
  "stage": "release",
  "title": "教学包发布质检与版本追溯",
  "description": "Audit all math-teaching deliverables, require genuine verified solution, storyboard, editable Manim, voiced MP4 and editable PPTX, then emit hashed release report.",
  "owner_role": "qa-auditor",
  "inputs": [
    "problem.json",
    "solution.md",
    "audit.json",
    "storyboard.md",
    "lesson_scene.py",
    "lesson.mp4",
    "practice.pptx"
  ],
  "outputs": [
    "release.json"
  ],
  "prerequisites": [
    "G0-G4 各阶段校验通过",
    "审校证据真实、音频为实际讲解内容、输入图片版权与隐私合规"
  ],
  "gates": [
    "只有所有强制门槛通过才能产生 release.json；发布后文件变更会使哈希校验失败。"
  ],
  "references": [
    "references/quality-rubric.md"
  ],
  "scripts": [
    "scripts/check_release.py"
  ],
  "assets": [
    "assets/release-checklist.md"
  ],
  "status": "starter-implementation",
  "requires_external_model": true,
  "requires_human_signoff_for_high_risk": true,
  "compatibility": [
    "Codex",
    "OpenCode",
    "Pi",
    "Claude Code"
  ]
}
