{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem intake",
  "type": "object",
  "required": [
    "schema_version",
    "problem_id",
    "source",
    "stem",
    "questions",
    "ambiguities",
    "knowledge_tags"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": [
        "image_paths",
        "language"
      ],
      "properties": {
        "image_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      }
    },
    "stem": {
      "type": "object",
      "required": [
        "text",
        "latex"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "latex": {
          "type": "string"
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "latex"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "latex": {
            "type": "string"
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "span",
          "resolved",
          "alternatives"
        ],
        "properties": {
          "span": {
            "type": "string"
          },
          "resolved": {
            "type": "boolean"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "resolution": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "knowledge_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "enum": [
        "standard",
        "high"
      ]
    },
    "risk_rationale": {
      "type": "string",
      "minLength": 10,
      "description": "Why this problem is NOT high risk. Required for risk_level=standard; enforced at G2."
    }
  }
}
