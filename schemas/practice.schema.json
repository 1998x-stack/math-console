{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Practice deck input",
  "type": "object",
  "required": [
    "schema_version",
    "problem_id",
    "lesson_title",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "problem_id": {
      "type": "string"
    },
    "lesson_title": {
      "type": "string",
      "minLength": 1
    },
    "teacher_notes": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "difficulty",
          "question",
          "answer",
          "solution",
          "knowledge_tags",
          "target_step_ids"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "difficulty": {
            "enum": [
              "foundation",
              "transfer",
              "challenge"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "solution": {
            "type": "string",
            "minLength": 1
          },
          "knowledge_tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_step_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minutes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
