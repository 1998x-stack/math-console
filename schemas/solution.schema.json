{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mathematical solution",
  "type": "object",
  "required": [
    "schema_version",
    "problem_id",
    "author",
    "assumptions",
    "steps",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "description": "Who produced this solution. Used at G2 to reject self-audit.",
      "required": [
        "agent_id",
        "context_id",
        "route"
      ],
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 4,
          "description": "The reasoning route actually used, e.g. 定义法 / 链式法则."
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question_id",
          "claim",
          "latex",
          "reason",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question_id": {
            "type": "string"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "latex": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proof_obligation": {
            "type": "boolean",
            "description": "True when this step is a proof, not a computation. Forces risk_level=high at G2."
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "conclusion",
          "latex"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "latex": {
            "type": "string"
          }
        }
      }
    },
    "alternative_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
