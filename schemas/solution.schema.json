{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mathematical solution",
  "type": "object",
  "required": [
    "schema_version",
    "problem_id",
    "assumptions",
    "steps",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "problem_id": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "question_id",
          "claim",
          "latex",
          "reason",
          "depends_on"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question_id": {
            "type": "string"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "latex": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "question_id",
          "conclusion",
          "latex"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "latex": {
            "type": "string"
          }
        }
      }
    },
    "alternative_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
