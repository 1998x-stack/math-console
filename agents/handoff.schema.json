{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent handoff contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "agent_id",
    "status",
    "inputs",
    "outputs",
    "evidence",
    "blockers",
    "next_agent"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^math-[a-z-]+$"
    },
    "status": {
      "enum": [
        "pending",
        "blocked",
        "needs-review",
        "complete"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "path",
          "summary"
        ],
        "properties": {
          "type": {
            "enum": [
              "file",
              "check",
              "review",
              "render",
              "human-approval"
            ]
          },
          "path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "upstream_gate": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
